# Copy to .env to override. Defaults point at the local emulators started by docker compose.
# Emulator credentials default (in docker-compose.yml) to the PUBLICLY DOCUMENTED local dev values
# (Azurite devstoreaccount1, Event Hubs SAS_KEY_VALUE, Cosmos emulator key). Override here only if needed.
# AZURITE_ACCOUNT_NAME=devstoreaccount1
# AZURITE_ACCOUNT_KEY=<azurite-dev-key>
# EVENTHUBS_SAS_KEY=<eventhubs-emulator-sas-key>
# COSMOS_KEY=<cosmos-key>
# To target real Azure, fill these in from your own resources and NEVER commit .env.

# EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
EVENTHUB_NAME=tweet-stream-eh1
EVENTHUB_COSMOS_CONSUMER_GROUP=cosmos-writer
EVENTHUB_LIVE_CONSUMER_GROUP=live-view

# STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
BLOB_CONTAINER=tweets
CHECKPOINT_CONTAINER=eventhub-checkpoints

# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_KEY=
COSMOS_DATABASE=hurricane
COSMOS_CONTAINER=tweets

# Producer (replays the stream into the ingest API)
PRODUCER_TWEETS_PER_SECOND=2
PRODUCER_LOOP=true
PRODUCER_INVALID_EVERY=25
# SAMPLE_PATH=/data/merged_tweets_image_metadata_stream.json   # real Kaggle-derived stream, if you have it

# Must be Y to run the Event Hubs emulator (Microsoft emulator license terms)
EVENTHUBS_EMULATOR_ACCEPT_EULA=Y
API_PORT=8000
FRONTEND_PORT=3000
